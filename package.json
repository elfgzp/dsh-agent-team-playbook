{
  "name": "dsh-agent-team-playbook",
  "version": "0.1.0",
  "private": true,
  "description": "Inject Agent Teams operating conventions into every session: roster planning, write-scope discipline, fresh-context task templates, and coordination traps.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-teams",
    "prompt",
    "playbook"
  ],
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
